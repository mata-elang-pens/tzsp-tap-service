#!/usr/bin/env python3
"""
tzsp-tap: Receives TZSP (MikroTik packet sniffer) on UDP 37008,
strips the TZSP header, and injects raw Ethernet frames into a TAP device.
"""
import socket
import struct
import os
import fcntl
import sys

TUNSETIFF = 0x400454ca
IFF_TAP   = 0x0002
IFF_NO_PI = 0x1000

TAP_NAME = "tap0"
TZSP_PORT = 37008


def create_tap(name: str) -> int:
    fd = os.open("/dev/net/tun", os.O_RDWR)
    ifr = struct.pack("16sH", name.encode(), IFF_TAP | IFF_NO_PI)
    fcntl.ioctl(fd, TUNSETIFF, ifr)
    os.system(f"ip link set {name} promisc on")
    os.system(f"ip link set {name} up")
    return fd


def parse_tzsp(data: bytes):
    """Return the inner Ethernet frame from a TZSP datagram, or None on error."""
    if len(data) < 4:
        return None
    version, pkt_type, _proto = struct.unpack("!BBH", data[:4])
    if version != 1:
        return None
    pos = 4
    while pos < len(data):
        tag = data[pos]
        pos += 1
        if tag == 0x01:   # END tag — payload starts here
            break
        if tag == 0x00:   # PADDING — no length byte
            continue
        if pos >= len(data):
            return None
        length = data[pos]
        pos += 1 + length
    return data[pos:] if pos < len(data) else None


def main():
    tap_fd = create_tap(TAP_NAME)

    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.bind(("0.0.0.0", TZSP_PORT))

    print(f"tzsp-tap: {TAP_NAME} up, listening on UDP {TZSP_PORT}", flush=True)

    while True:
        data, _ = sock.recvfrom(65535)
        frame = parse_tzsp(data)
        if frame:
            try:
                os.write(tap_fd, frame)
            except OSError as e:
                print(f"write error: {e}", file=sys.stderr, flush=True)


if __name__ == "__main__":
    main()
